# Required: MongoDB connection string (local MongoDB example below)
MONGODB_URI=mongodb://127.0.0.1:27017/mode-market

# Required: use a long random value in production
JWT_SECRET=replace-with-a-long-random-secret

# Optional
PORT=4000
# Comma-separated frontend origins. Use * only for local development.
CORS_ORIGIN=http://localhost:3000
# Optional: accounts created with these addresses receive the administrator role.
ADMIN_EMAILS=owner@example.com
